# Proveedores
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Cohere (reranking, config C). El SDK de Cohere autodetecta CO_API_KEY; el
# proyecto también acepta COHERE_API_KEY. Basta con definir UNA de las dos.
CO_API_KEY=
COHERE_API_KEY=

# Modelos (overrideables)
EMBEDDING_MODEL=text-embedding-3-large
GENERATOR_MODEL=gpt-4o-mini
JUDGE_MODEL=gpt-4o
RERANK_MODEL=rerank-multilingual-v3.0

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=normarag_ran

# Retrieval
TOP_K_DENSE=20
TOP_K_SPARSE=20
TOP_K_RERANK=6
