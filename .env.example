# Proveedores
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Cohere (reranking, config C). El SDK de Cohere autodetecta CO_API_KEY; el
# proyecto también acepta COHERE_API_KEY. Basta con definir UNA de las dos.
CO_API_KEY=
COHERE_API_KEY=

# Modelos (overrideables). Ver "Experimentar con configuraciones" en el README.
EMBEDDING_MODEL=text-embedding-3-large   # cambiarlo exige re-indexar y ajustar EMBEDDING_DIM
EMBEDDING_DIM=3072                        # 3-large=3072, 3-small=1536 (DEBE coincidir)
GENERATOR_MODEL=gpt-4o-mini               # p. ej. gpt-4o / gpt-4.1 para un modelo más caro
JUDGE_MODEL=gpt-4o                         # juez RAGAS (distinto del generador)
RERANK_MODEL=rerank-multilingual-v3.0

# Chunking (M1). Cambiarlos exige re-chunkear e indexar: make ingest && make index
CHUNK_MAX_TOKENS=800
CHUNK_OVERLAP_RATIO=0.15

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=normarag_ran

# Retrieval (sin re-indexar; efecto inmediato en consultas/eval)
TOP_K_DENSE=20
TOP_K_SPARSE=20
TOP_K_RERANK=6
